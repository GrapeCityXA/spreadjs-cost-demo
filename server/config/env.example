# Backend runtime environment. Copy to server/.env for local development, or
# merge into the systemd EnvironmentFile on a server. Never commit real secrets.

PORT=3000
HOST=0.0.0.0
# 可选：由应用自己监听部署子路径，上游代理原样转发、不做重写。
# 必须与前端构建的 VITE_BASE_PATH 一致，末尾不要加斜杠。
# APP_BASE_PATH=/spreadjs/cost-report
JWT_SECRET=replace-with-a-long-random-secret
# License values are read only from the process environment; there is no LICENSE.js file.
# Frontend build: SPREADJS_LICENSE / DESIGNER_LICENSE
# Backend: SERVER_LICENSE (and SPREADJS_LICENSE for server-side rendering)
# SPREADJS_LICENSE=...
# DESIGNER_LICENSE=...
# SERVER_LICENSE=...

# Optional storage overrides. Defaults are under server/data/demo.
COST_REPORT_DB_PATH=/absolute/path/to/server/data/demo/business.db
COST_REPORT_COLLAB_DB_PATH=/absolute/path/to/server/data/demo/collaboration.db
COST_REPORT_TEMPLATE_DIR=/absolute/path/to/server/data/demo/templates
COST_REPORT_ARTIFACT_DIR=/absolute/path/to/server/data/demo/artifacts
COST_REPORT_BACKUP_DIR=/absolute/path/to/server/data/demo/backups
COST_REPORT_RESET_BACKUP_DIR=/absolute/path/to/server/data/demo-reset-backups

# Optional override. The default video URL lives in server/config/showcase.json.
# GUIDE_MEDIA_BASE_URL=https://videos.grapecity.com.cn/SpreadJS/online/demos/cost-demo/

# Showcase reset defaults live in server/config/showcase.json.
# The SHOWCASE_RESET_* environment variables are optional overrides.
