{
  "name": "vue3-spreadjs-designer",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:showcase": "vite --mode showcase --port 5199",
    "build": "node --max-old-space-size=8192 node_modules/vite/bin/vite.js build",
    "build:showcase": "node --max-old-space-size=8192 node_modules/vite/bin/vite.js build --mode showcase",
    "preview": "vite preview",
    "preview:showcase": "vite preview --mode showcase --port 5199",
    "server": "cd server && npm run dev",
    "server:install": "cd server && npm install",
    "start:all": "concurrently \"npm run dev\" \"npm run server\"",
    "demo:reset": "node server/scripts/reset-demo.cjs",
    "test:demo-reset": "node --test server/test/reset-demo.test.cjs server/test/demo-reset-deployment.test.cjs",
    "demo:timer": "node server/scripts/install-demo-reset.cjs",
    "test:api-cleanup": "node server/test/retired-api.integration.test.cjs",
    "test:schema": "node --test server/test/retired-tables-migration.test.cjs",
    "test:api": "npm run test:schema && npm run test:api-cleanup && node server/test/api.integration.test.cjs && node server/test/original-data-exports.integration.test.cjs",
    "test:formula": "node --test server/test/rule-evaluator.parity.test.cjs server/test/formula-precheck.test.cjs server/test/monthly-history-fixture.test.cjs server/test/precheck-version.test.cjs",
    "test:submission": "node --test server/test/submission-extraction.test.cjs server/test/business-submission-transaction.test.cjs",
    "test:monthly-reference": "node --test server/test/monthly-reference-report.test.cjs server/test/monthly-reference-loading.test.cjs",
    "test:report-jobs": "node --test server/test/report-job-recovery.test.cjs server/test/report-job-multiprocess.test.cjs",
    "test:quarterly-dependencies": "node --test server/test/quarterly-dependencies.test.cjs server/test/submission-extraction.test.cjs",
    "test:quarterly-review": "node --test server/test/quarterly-review-scoring.test.cjs",
    "test:checkpoint": "node server/test/checkpoint-recovery.integration.test.cjs",
    "test:permission": "node --test server/test/permission-authorization.test.cjs",
    "test:browser": "node tests/browser-acceptance.mjs",
    "test:acceptance": "npm run test:permission && npm run test:api && npm run test:submission && npm run test:monthly-reference && npm run test:report-jobs && npm run test:quarterly-dependencies && npm run test:quarterly-review && npm run test:checkpoint && npm run test:browser",
    "media:download": "node scripts/download-demo-media.mjs",
    "media:prepare": "node scripts/prepare-guide-media.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "@grapecity-software/js-collaboration-client": "19.2.0",
    "@grapecity-software/js-collaboration-ot-client": "19.2.0",
    "@grapecity-software/js-collaboration-presence-client": "19.2.0",
    "@grapecity-software/spread-sheets": "19.2.0",
    "@grapecity-software/spread-sheets-barcode": "19.2.0",
    "@grapecity-software/spread-sheets-charts": "19.2.0",
    "@grapecity-software/spread-sheets-collaboration-addon": "19.2.0",
    "@grapecity-software/spread-sheets-collaboration-client": "19.2.0",
    "@grapecity-software/spread-sheets-datacharts-addon": "19.2.0",
    "@grapecity-software/spread-sheets-designer": "19.2.0",
    "@grapecity-software/spread-sheets-designer-resources-cn": "19.2.0",
    "@grapecity-software/spread-sheets-formula-panel": "19.2.0",
    "@grapecity-software/spread-sheets-io": "19.2.0",
    "@grapecity-software/spread-sheets-languagepackages": "19.2.0",
    "@grapecity-software/spread-sheets-pdf": "19.2.0",
    "@grapecity-software/spread-sheets-print": "19.2.0",
    "@grapecity-software/spread-sheets-reportsheet-addon": "19.2.0",
    "@grapecity-software/spread-sheets-resources-zh": "19.2.0",
    "@grapecity-software/spread-sheets-shapes": "19.2.0",
    "@grapecity-software/spread-sheets-slicers": "19.2.0",
    "@grapecity-software/spread-sheets-tablesheet": "19.2.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.8.0",
    "jquery": "3.7.1",
    "jsignature": "2.1.3",
    "monaco-editor": "0.57.0",
    "vue": "^3.4.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.2",
    "vite": "^5.0.0"
  }
}
